{
  "rules": {
    ".read": false,
    ".write": false,

    "global_archives": {
      ".read": true,
      ".write": false
    },
    "stats": {
      ".read": true,
      ".write": false
    },
    "short_links": {
      ".read": true,
      ".write": false
    },
    
    "admins": {
      ".read": false,
      ".write": false
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "webhooks": {
      "$roomId": {
        ".read": false,
        ".write": "newData.val() == null || (newData.child('url').val().matches(/^https:\\/\\/discord\\.com\\/api\\/webhooks\\//) && newData.child('url').val().length < 200)"
      }
    },
    "hall_of_fame": {
      ".read": true,
      ".write": false,
      "$entryId": {
        ".write": "auth != null && (!data.exists() || newData.exists())"
      }
    },
    "rooms": {
      ".read": true,
      ".write": false,
      "$roomId": {
        ".write": "auth != null && $roomId.length >= 3 && $roomId.length <= 32"
      }
    },
    "booster_drafts": {
      ".read": true,
      ".write": false,
      "$draftId": {
        ".write": "auth != null && $draftId.length >= 3 && $draftId.length <= 48"
      }
    }
  }
}