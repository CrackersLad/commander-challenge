{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/forge-engine/patches.jar",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, HEAD, OPTIONS"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "Range, Content-Type, Accept"
          },
          {
            "key": "Access-Control-Expose-Headers",
            "value": "Content-Range, Content-Length, Accept-Ranges"
          },
          {
            "key": "Accept-Ranges",
            "value": "bytes"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/forge-engine/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, HEAD, OPTIONS"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "Range, Content-Type, Accept"
          },
          {
            "key": "Access-Control-Expose-Headers",
            "value": "Content-Range, Content-Length, Accept-Ranges"
          },
          {
            "key": "Accept-Ranges",
            "value": "bytes"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/simulate/stream",
        "function": "simulateStream"
      },
      {
        "source": "/compareDecks",
        "function": "compareDecks"
      },
      {
        "source": "/getDeckName",
        "function": "getDeckName"
      },
      {
        "source": "/getSets",
        "function": "getSets"
      },
      {
        "source": "/checkSetProgress",
        "function": "checkSetProgress"
      },
      {
        "source": "/suggestImprovements",
        "function": "suggestImprovements"
      },
      {
        "source": "/getCollectionInsights",
        "function": "getCollectionInsights"
      },
      {
        "source": "/searchCommanderDecks",
        "function": "searchCommanderDecks"
      },
      {
        "source": "/summarizeMatch",
        "function": "summarizeMatch"
      },
      {
        "source": "/recommendCardsFromEnteredDecks",
        "function": "recommendCardsFromEnteredDecks"
      },
      {
        "source": "/shortenUrl",
        "function": "shortenUrl"
      },
      {
        "source": "/submitFeedback",
        "function": "submitFeedback"
      },
      {
        "source": "/s/**",
        "function": "shortenUrl"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "**/node_modules/**",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "**/.env"
      ]
    }
  ]
}
